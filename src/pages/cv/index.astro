---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadCv } from '@/lib/cv';

const cv = loadCv();

const workAwards = (await getCollection('work', ({ data }) => !data.draft && Boolean(data.award))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const awards: {
  title: string;
  place: string;
  dates: string;
  description?: string;
  href?: string;
}[] = [
  {
    title: 'AEPIA Best Master’s Thesis Award',
    place: 'EVIA 2025',
    dates: '2025',
    href: 'https://www.aepia.org/evia2025/',
  },
  ...cv.awards,
  ...workAwards.map((entry) => ({
    title: [entry.data.event, entry.data.award].filter(Boolean).join(', '),
    place: entry.data.title,
    dates: String(entry.data.year),
    href: `/work/${entry.id}`,
  })),
];
---

<BaseLayout title="CV" description={`Curriculum vitae of ${cv.name}.`}>
  <article class="mx-auto max-w-page px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">CV</p>
    <h1 class="text-ink max-w-xl text-3xl font-medium tracking-tight sm:text-4xl">Curriculum Vitae</h1>
    <p class="text-ink-soft mt-6 max-w-measure leading-relaxed">
      {cv.headline}
      {cv.location && ` Based in ${cv.location}.`}
    </p>
    <a href="/cv/cv.pdf" class="text-signal mt-8 inline-block font-mono text-sm hover:underline">
      Download CV
    </a>

    <section class="mt-16 sm:mt-20">
      <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">Experience</h2>
      <div class="mt-6">
        {
          cv.experience.map((entry) => (
            <article class="border-line grid grid-cols-1 items-baseline gap-2 border-b py-7 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
              <p class="text-ink-soft font-mono text-xs">{entry.dates}</p>
              <div>
                <h3
                  class:list={[
                    'text-[1.15rem] font-medium tracking-tight',
                    entry.current ? 'text-signal' : 'text-ink',
                  ]}
                >
                  {entry.title}
                </h3>
                <p class="text-ink-soft mt-1 text-sm">
                  {entry.place}
                  {entry.location && ` · ${entry.location}`}
                </p>
                {entry.description && (
                  <p class="text-ink-soft mt-3 max-w-measure leading-relaxed">{entry.description}</p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">Education</h2>
      <div class="mt-6">
        {
          cv.education.map((entry) => (
            <article class="border-line grid grid-cols-1 items-baseline gap-2 border-b py-6 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
              <p class="text-ink-soft font-mono text-xs">{entry.dates}</p>
              <div>
                <h3 class="text-ink text-[1.05rem] font-medium tracking-tight">{entry.title}</h3>
                <p class="text-ink-soft mt-1 text-sm">{entry.place}</p>
                {entry.note && <p class="text-ink-soft mt-2 max-w-measure text-sm leading-relaxed">{entry.note}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">Publications</h2>
      <div class="mt-6">
        {
          cv.publications.map((paper) => (
            <a
              href={paper.href}
              class="border-line group block border-b py-6"
            >
              <p class="text-ink group-hover:text-signal text-[1.05rem] leading-snug font-medium tracking-tight transition-colors">
                {paper.title}
              </p>
              <p class="text-ink-soft mt-2 font-mono text-xs">
                {[paper.venue, paper.year].filter(Boolean).join(' · ')}
              </p>
            </a>
          ))
        }
      </div>
      <a href="/research" class="text-signal mt-6 inline-block font-mono text-xs hover:underline">
        All publications →
      </a>
    </section>

    <section class="mt-16">
      <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">Teaching</h2>
      <p class="text-ink-soft mt-6 max-w-measure leading-relaxed">
        Undergraduate and Master’s courses at UDC and UIMP, plus supervised thesis work.
      </p>
      <a href="/teaching" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
        Teaching →
      </a>
    </section>

    {
      awards.length > 0 && (
        <section class="mt-16">
          <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">
            Awards
          </h2>
          <div class="mt-6">
            {awards.map((entry) =>
              entry.href ? (
                <a
                  href={entry.href}
                  class="border-line group grid grid-cols-1 items-baseline gap-2 border-b py-6 sm:grid-cols-[9.5rem_1fr] sm:gap-8"
                >
                  <p class="text-ink-soft font-mono text-xs">{entry.dates}</p>
                  <div>
                    <h3 class="text-ink group-hover:text-signal text-[1.05rem] font-medium tracking-tight transition-colors">
                      {entry.title}
                    </h3>
                    {entry.place && <p class="text-ink-soft mt-1 text-sm">{entry.place}</p>}
                  </div>
                </a>
              ) : (
                <article class="border-line grid grid-cols-1 items-baseline gap-2 border-b py-6 sm:grid-cols-[9.5rem_1fr] sm:gap-8">
                  <p class="text-ink-soft font-mono text-xs">{entry.dates}</p>
                  <div>
                    <h3 class="text-ink text-[1.05rem] font-medium tracking-tight">{entry.title}</h3>
                    {entry.place && <p class="text-ink-soft mt-1 text-sm">{entry.place}</p>}
                    {entry.description && (
                      <p class="text-ink-soft mt-2 max-w-measure text-sm leading-relaxed">{entry.description}</p>
                    )}
                  </div>
                </article>
              ),
            )}
          </div>
        </section>
      )
    }

    <section class="mt-16">
      <h2 class="text-ink-soft font-mono text-[0.8125rem] tracking-[0.18em] uppercase">Skills</h2>
      <div class="mt-6 max-w-measure">
        {
          cv.skills.map((skill) => (
            <p class="border-line border-b py-5">
              <span class="text-ink font-medium">{skill.label}</span>
              <span class="text-ink-soft mt-1 block leading-relaxed">{skill.details}</span>
            </p>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
