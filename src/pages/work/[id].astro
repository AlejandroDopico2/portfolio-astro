---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkFigure from '@/components/WorkFigure.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, subtitle, year, event, award, heroImage, gallery, links } = entry.data;
const { Content } = await render(entry);

const meta = [year, event, award].filter(Boolean).join(' · ');
const description = subtitle ?? meta;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-page mx-auto px-6 pt-16 pb-24 sm:pt-24">
    <a href="/work" class="text-ink-soft hover:text-signal font-mono text-xs transition-colors">
      ← Projects
    </a>

    <header class="max-w-measure mt-8">
      <h1 class="text-ink text-3xl leading-tight font-medium tracking-tight sm:text-4xl">
        {title}
      </h1>
      <p class="text-ink-soft mt-3 font-mono text-xs">{meta}</p>
    </header>

    {
      heroImage && (
        <WorkFigure
          src={heroImage.src}
          alt={heroImage.alt}
          caption={heroImage.caption}
          priority
          class="mt-10"
        />
      )
    }

    <div class="project-body prose prose-sm sm:prose-base mt-10 max-w-none">
      <Content />
    </div>

    {
      links.length > 0 && (
        <nav class="mt-12" aria-label="Project links">
          <p class="text-ink-soft font-mono text-xs tracking-[0.18em] uppercase">Links</p>
          <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-signal hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      gallery.length > 0 && (
        <div class:list={['mt-16', gallery.length > 1 && 'grid items-start gap-5 sm:grid-cols-2']}>
          {gallery.map((figure) => (
            <WorkFigure src={figure.src} alt={figure.alt} caption={figure.caption} />
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .project-body :global(> p:first-of-type) {
    color: var(--color-ink);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .project-body :global(:is(p, ul, ol)) {
    max-width: 47rem;
    text-align: left;
  }

  .project-body :global(p:has(> img)) {
    max-width: none;
  }

  .project-body :global(img) {
    width: 100%;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(26, 28, 31, 0.08);
  }

  :global(.dark) .project-body :global(img) {
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
</style>
