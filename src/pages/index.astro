---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-page px-6 pt-20 pb-20 sm:pt-28 sm:pb-24">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between md:gap-16">
      <div class="min-w-0 flex-1">
        <h1 class="font-display text-ink max-w-3xl text-[2.4rem] leading-[1.18] font-normal tracking-tight sm:text-[3.1rem]">
          {SITE.intro}
        </h1>

        <div class="text-ink-soft mt-8 max-w-measure space-y-5 leading-relaxed">
          {SITE.lead.map((paragraph) => <p set:html={paragraph} />)}
        </div>

        <!-- Hover (desktop) or tap (mobile, via tabindex focus) to reveal. -->
        <div class="now group mt-9 w-fit" tabindex="0">
          <p class="text-ink-soft group-hover:text-ink group-focus-within:text-ink w-fit cursor-default font-mono text-sm transition-colors">
            What am I doing right now?
            <span class="now-caret text-signal ml-1 inline-block">↓</span>
          </p>
          <div class="now-panel">
            <ol class="text-ink-soft min-h-0 space-y-2 text-[1.05rem] leading-snug">
              {
                SITE.now.map((item, i) => (
                  <li class="now-item flex gap-3 first:mt-4" style={`--i:${i}`}>
                    <span class="text-signal font-mono text-sm leading-[1.45]">{String(i + 1).padStart(2, '0')}</span>
                    {item}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <figure class="w-56 shrink-0 md:w-[17.5rem]">
        <img
          src="/images/profile.jpg"
          alt={`${SITE.name} on stage with a microphone at HackUDC`}
          width="280"
          height="280"
          class="aspect-square w-full rounded-[4px] object-cover"
        />
        <figcaption class="text-ink-soft mt-3 text-sm leading-snug">{SITE.photoCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="work" class="mx-auto max-w-page px-6 pb-20 sm:pb-24">
    <SectionHeading title="Things I've built" />
    <div class="border-line border-t">
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>
    {
      allWork.length > selected.length && (
        <div class="mt-8">
          <a
            href="/work"
            class="link-anim text-ink-soft hover:text-signal text-sm transition-colors"
          >
            View all {allWork.length} projects →
          </a>
        </div>
      )
    }
  </section>

  <section id="contact" class="mx-auto max-w-page px-6 pb-24 sm:pb-28">
    <SectionHeading title="Say hi" />
    <p class="text-ink-soft max-w-measure leading-relaxed">
      {SITE.contactNote}
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="link-anim text-signal mt-6 inline-flex items-center gap-2 font-mono text-[0.95rem]"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>

<style>
  .now-panel {
    display: grid;
    grid-template-rows: 0fr;
  }
  .now-panel > ol {
    overflow: hidden;
  }
  .now-item {
    opacity: 0;
    transform: translateY(4px);
  }
  .now:hover .now-panel,
  .now:focus-within .now-panel {
    grid-template-rows: 1fr;
  }
  .now:hover .now-item,
  .now:focus-within .now-item {
    opacity: 1;
    transform: none;
  }
  .now:hover .now-caret,
  .now:focus-within .now-caret {
    transform: rotate(180deg);
  }
  .now:focus-visible {
    outline: none;
  }
  .now:focus-visible p {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .now-panel {
      transition: grid-template-rows 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .now-caret {
      transition: transform 300ms ease;
    }
    .now-item {
      transition:
        opacity 350ms ease,
        transform 350ms ease;
    }
    .now:hover .now-item,
    .now:focus-within .now-item {
      transition-delay: calc(120ms + var(--i) * 70ms);
    }
  }
</style>
