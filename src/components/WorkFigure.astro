---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  priority = false,
  sizes = '(min-width: 56rem) 53rem, calc(100vw - 3rem)',
  class: className,
} = Astro.props;
---

<figure class:list={['m-0', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1800]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    class="w-full rounded-[10px] object-cover shadow-[0_1px_4px_rgba(26,28,31,0.08)] dark:shadow-[0_1px_6px_rgba(0,0,0,0.4)]"
  />
  {caption && <figcaption class="text-ink-soft mt-3 font-mono text-xs">{caption}</figcaption>}
</figure>
