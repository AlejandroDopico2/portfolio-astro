---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { title, authors, year, type, venue, doi, arxiv, pdf, code, abstract } = entry.data;

const typeLabel = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint',
}[type];

const links = [
  pdf ? { label: 'PDF', href: pdf } : null,
  arxiv ? { label: 'arXiv', href: `https://arxiv.org/abs/${arxiv}` } : null,
  doi ? { label: 'DOI', href: `https://doi.org/${doi}` } : null,
  code ? { label: 'Code', href: code } : null,
].filter((link) => link !== null);
---

<article class="border-line border-b py-8" data-paper data-type={type}>
  <h3 class="text-ink text-[1.15rem] leading-snug font-medium tracking-tight">
    {title}
  </h3>

  <p class="text-ink-soft mt-2 text-sm leading-relaxed">
    {authors.join(', ')}
  </p>

  <p class="text-ink-soft mt-2 font-mono text-xs">
    {venue} · {year} · {typeLabel}
  </p>

  {
    links.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
        {links.map((link) => (
          <a href={link.href} class="text-signal hover:underline">
            {link.label}
          </a>
        ))}
      </p>
    )
  }

  <details class="mt-4">
    <summary class="text-ink-soft hover:text-ink cursor-pointer font-mono text-xs">
      Abstract
    </summary>
    <p class="text-ink-soft mt-3 max-w-measure text-sm leading-relaxed">{abstract}</p>
  </details>
</article>
