---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, date, tags } = entry.data;

const stamp = formatDate(date, "compact");
---

<a
  href={`/work/${entry.id}`}
  class="group border-line grid grid-cols-[3.5rem_1fr_auto] items-center gap-4 border-b py-7 sm:grid-cols-[4.75rem_1fr_auto] sm:gap-7"
>
  <span class="text-ink-soft font-mono text-xs">{stamp}</span>

  <span class="min-w-0">
    <span
      class="text-ink group-hover:text-signal block truncate text-[1.15rem] font-medium tracking-tight transition-colors"
    >
      {title}
    </span>
    <span class="text-ink-soft hidden truncate text-sm sm:block">{summary}</span>
  </span>

  <span class="flex items-center gap-4">
    <span class="text-ink-soft hidden font-mono text-[11px] md:block">
      {tags.slice(0, 2).join(' · ')}
    </span>
    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-colors"
    >
      →
    </span>
  </span>
</a>
